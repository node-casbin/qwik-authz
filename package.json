{
  "name": "qwik-authz",
  "version": "1.0.0",
  "description": "Authorization middleware for Qwik based on Casbin",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsc",
    "lint": "eslint \"src/**/*.{ts,js}\"",
    "fix": "eslint \"src/**/*.{ts,js}\" --fix",
    "test": "jest",
    "coverage": "jest --coverage",
    "prepublishOnly": "npm run lint && npm run test && npm run build",
    "release": "npx -p semantic-release -p @semantic-release/git -p @semantic-release/changelog semantic-release"
  },
  "files": [
    "lib",
    "examples"
  ],
  "keywords": [
    "casbin",
    "node-casbin",
    "qwik",
    "authorization",
    "authz",
    "middleware",
    "access-control",
    "acl",
    "rbac",
    "abac"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/node-casbin/qwik-authz.git"
  },
  "author": "Node-Casbin",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/node-casbin/qwik-authz/issues"
  },
  "homepage": "https://github.com/node-casbin/qwik-authz#readme",
  "peerDependencies": {
    "casbin": "^5.0.0",
    "@builder.io/qwik-city": "^1.0.0"
  },
  "devDependencies": {
    "@builder.io/qwik-city": "^1.10.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "casbin": "^5.30.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts"
    ]
  }
}
